# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/bantuan_lapangan

# API Base (dipakai untuk type/instance pada Problem Details)
BASE_URL=http://localhost:3000

# OIDC (Keycloak) — service menolak start bila salah satu kosong
OIDC_ISSUER=http://localhost:8080/realms/bantuan-lapangan
OIDC_JWKS_URI=http://localhost:8080/realms/bantuan-lapangan/protocol/openid-connect/certs
OIDC_AUDIENCE=bantuan-lapangan-api
